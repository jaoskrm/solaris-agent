# Red Team Agent Swarm Configuration
# Copy this file to .env and customize for your environment

# Redis (message bus)
# Note: Blue Team uses port 6380, Red Team uses port 6381
REDIS_URL=redis://localhost:6381

# Ollama (local LLMs)
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter (cloud LLMs - optional, only used if explicitly enabled)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Target
JUICE_SHOP_URL=http://localhost:3000

# Model selection (per PRD Section 3.2)
# Commander: local Ollama model (llama3:latest)
COMMANDER_MODEL_LOCAL=llama3:latest
# Commander: OpenRouter cloud model (fallback - not used in local-only mode)
COMMANDER_MODEL=qwen/qwen3-235b-a22b:free

# Alpha Recon: llama3:latest via Ollama (local)
RECON_MODEL=llama3:latest

# Gamma Exploit: qwen2.5-coder:7b via Ollama (local)
EXPLOIT_MODEL=qwen2.5-coder:7b-instruct

# Critic Agent: qwen2.5-coder:7b via Ollama (local)
CRITIC_MODEL=qwen2.5-coder:7b-instruct

# HITL (Phase 3)
HITL_TIMEOUT_SECONDS=120
MAX_REFLECTION_ITERATIONS=3