# Application
NODE_ENV=development
LOG_LEVEL=info

# ===========================================
# FALKORDB (Graph Memory) - RAILWAY (PRODUCTION)
# ===========================================
# FalkorDB on Railway - Primary for production
# Get these values from your Railway project dashboard
FALKORDB_HOST=your-falkordb-host.railway.app
FALKORDB_PORT=6379
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=your-railway-falkordb-password
FALKORDB_DATABASE=0

# ===========================================
# SUPABASE (Persistent Storage)
# ===========================================
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJxxx
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# SQLITE (Event Bus - LOCAL)
# ===========================================
# SQLite file created automatically at ./solaris-events.db
# SQLITE_EVENTS_PATH=./solaris-events.db

# ===========================================
# OLLAMA (Local LLM) - TIER 1 & 2 AGENTS (Unlimited, RTX 4080)
# ===========================================
# Ollama models: nemotron-3-nano, phi-3-mini, llama3-groq-tool-use:8b-q4_K_M, qwen2.5-coder:7b-q4_K_M
# Download with: ollama pull <model-name>
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ENABLED=true

# Per-agent model overrides (optional - defaults below)
# TIER 1 (Nano - 2GB each)
# VERIFIER_MODEL=nemotron-3-nano
# VERIFIER_MODEL_FALLBACK=phi-3-mini
# CRITIC_MODEL=nemotron-3-nano
# CRITIC_MODEL_FALLBACK=phi-3-mini

# TIER 2 (Mid - 4-5GB each)
# GAMMA_MODEL=llama3-groq-tool-use:8b-q4_K_M
# GAMMA_MODEL_FALLBACK=qwen2.5-coder:7b-q4_K_M
# ALPHA_MODEL=qwen2.5-coder:7b-q4_K_M
# ALPHA_MODEL_FALLBACK=llama3-groq-tool-use:8b-q4_K_M
# MCP_MODEL=llama3-groq-tool-use:8b-q4_K_M
# MCP_MODEL_FALLBACK=qwen2.5-coder:7b-q4_K_M
# SPECIALIST_MODEL=llama3-groq-tool-use:8b-q4_K_M
# SPECIALIST_MODEL_FALLBACK=qwen2.5-coder:7b-q4_K_M
# POST_MODEL=qwen2.5-coder:7b-q4_K_M
# POST_MODEL_FALLBACK=llama3-groq-tool-use:8b-q4_K_M

# ===========================================
# GROQ - TIER 3 (30 RPM free)
# ===========================================
# Get from https://console.groq.com/
# Models: llama3-groq-tool-use:70b, llama-3.3-70b-versatile
GROQ_API_KEY=

# ===========================================
# CEREBRAS - TIER 4 OSINT (1M tokens/day free!)
# ===========================================
# Get from https://cloud.cerebras.ai/
# Models: llama3.3-70b, qwen3-32b
CEREBRAS_API_KEY=

# ===========================================
# OPENROUTER - TIER 4 PLANNING + TIER 5 OUTPUT (20 RPM free)
# ===========================================
# Get from https://openrouter.ai/keys
# Models: nvidia/nemotron-3-super:free, deepseek-v3:free, deepseek-r1:free, gpt-oss-120b:free, gemma-3-27b:free
OPENROUTER_API_KEY=

# ===========================================
# ANTHROPIC - FALLBACK ONLY
# ===========================================
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ===========================================
# GOOGLE (Gemini) - FALLBACK ONLY
# ===========================================
# Get from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Per-agent model overrides for cloud (optional)
# TIER 3 (Reasoning)
# COMMANDER_MODEL=llama3-groq-tool-use:70b
# COMMANDER_MODEL_FALLBACK=llama-3.3-70b-versatile
# TIER 4 (Planning)
# PLANNER_MODEL=nvidia/nemotron-3-super:free
# PLANNER_MODEL_FALLBACK=deepseek-v3:free
# CHAIN_MODEL=deepseek-r1:free
# CHAIN_MODEL_FALLBACK=qwen3-32b:free
# OSINT_MODEL=llama3.3-70b
# OSINT_MODEL_FALLBACK=qwen3-32b
# TIER 5 (Output)
# REPORT_MODEL=gpt-oss-120b:free
# REPORT_MODEL_FALLBACK=gemma-3-27b:free

# ===========================================
# AGENT CONFIGURATION
# ===========================================
# Set at runtime by PM2
# AGENT_ROLE=commander
# AGENT_INSTANCE_ID=commander-1

# ===========================================
# SECURITY
# ===========================================
AUTHORIZATION_HMAC_SECRET=change-this-secret-in-production
CREDENTIAL_VAULT_KEY=your-fernet-key-here