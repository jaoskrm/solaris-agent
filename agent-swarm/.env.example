# Application
NODE_ENV=development
LOG_LEVEL=info

# ===========================================
# FALKORDB (Graph Memory) - RAILWAY (PRODUCTION)
# ===========================================
# FalkorDB on Railway - Primary for production
# Get these values from your Railway project dashboard
FALKORDB_HOST=your-falkordb-host.railway.app
FALKORDB_PORT=6379
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=your-railway-falkordb-password
FALKORDB_DATABASE=0

# ===========================================
# SUPABASE (Persistent Storage)
# ===========================================
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJxxx
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# SQLITE (Event Bus - LOCAL)
# ===========================================
# SQLite file created automatically at ./solaris-events.db
# SQLITE_EVENTS_PATH=./solaris-events.db

# ===========================================
# OLLAMA (Local LLM) - TIER 1 & 2 AGENTS
# ===========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ENABLED=false

# Per-agent model overrides (optional - defaults in code)
# VERIFIER_MODEL=nemotron-3-nano
# VERIFIER_MODEL_FALLBACK=nemotron-3-nano
# CRITIC_MODEL=nemotron-3-nano
# CRITIC_MODEL_FALLBACK=nemotron-3-nano
# GAMMA_MODEL=qwen2.5:14b-instruct
# GAMMA_MODEL_FALLBACK=qwen2.5:14b
# ALPHA_MODEL=qwen2.5:14b-instruct
# ALPHA_MODEL_FALLBACK=qwen2.5:14b
# MCP_MODEL=qwen2.5:14b-instruct
# MCP_MODEL_FALLBACK=qwen2.5:14b
# SPECIALIST_MODEL=qwen2.5:14b-instruct
# SPECIALIST_MODEL_FALLBACK=qwen2.5:14b
# POST_MODEL=qwen2.5:14b-instruct
# POST_MODEL_FALLBACK=qwen2.5:14b

# ===========================================
# GROQ - TIER 4 FALLBACK
# ===========================================
# Get from https://console.groq.com/
GROQ_API_KEY=

# ===========================================
# CEREBRAS - TIER 4 FALLBACK
# ===========================================
# Get from https://cloud.cerebras.ai/
CEREBRAS_API_KEY=csk-dp9tm2dkrv54ktx3kxpfdnhw3rdve3v5m9mmxk6hcerx2595

# ===========================================
# OPENROUTER - TIER 3 AGENTS (Commander)
# ===========================================
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ===========================================
# ANTHROPIC - TIER 3/4 FALLBACK
# ===========================================
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ===========================================
# GOOGLE (Gemini) - TIER 4 AGENTS
# ===========================================
# Get from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Per-agent model overrides for cloud (optional - defaults in code)
# COMMANDER_MODEL=nvidia/nemotron-3-super
# COMMANDER_MODEL_FALLBACK=google/gemini-2.0-flash
# PLANNER_MODEL=google/gemini-2.0-flash
# PLANNER_MODEL_FALLBACK=groq/llama-3.3-70b
# CHAIN_MODEL=google/gemini-2.0-flash
# CHAIN_MODEL_FALLBACK=groq/llama-3.3-70b
# OSINT_MODEL=google/gemini-2.0-flash
# OSINT_MODEL_FALLBACK=groq/llama-3.3-70b
# REPORT_MODEL=google/gemini-1.5-pro
# REPORT_MODEL_FALLBACK=openrouter/anthropic/claude-3.5-haiku

# ===========================================
# AGENT CONFIGURATION
# ===========================================
# Set at runtime by PM2
# AGENT_ROLE=commander
# AGENT_INSTANCE_ID=commander-1

# ===========================================
# SECURITY
# ===========================================
AUTHORIZATION_HMAC_SECRET=change-this-secret-in-production
CREDENTIAL_VAULT_KEY=your-fernet-key-here
